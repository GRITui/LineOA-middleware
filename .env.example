# apps/api (Vapor backend)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=vapor
DATABASE_PASSWORD=vapor
DATABASE_NAME=lineoa_booking

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF URL the LINE OA CTA opens (see GitHub issue #14). Set LIFF_URL directly,
# or just LINE_LIFF_ID and it's built as https://liff.line.me/<id> — same id as
# apps/liff's NEXT_PUBLIC_LIFF_ID.
LIFF_URL=
LINE_LIFF_ID=

# apps/liff (Next.js LIFF frontend) — see apps/liff/.env.example
